{
  "name": "shortcut-for-orca",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:findoo/shortcut-for-orca",
  "author": "findoo",
  "description": "Local Jira Server API facade over Shortcut, so Orca's Jira integration works with Shortcut.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "jest",
    "build": "node scripts/build.mjs",
    "app": "pnpm build && electron .",
    "app:smoke": "pnpm build && SMOKE=1 electron .",
    "icons": "electron scripts/icons.mjs",
    "dist": "pnpm build && electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "marked": "^18.1.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "main": "dist/main.cjs",
  "packageManager": "pnpm@12.9.1"
}
